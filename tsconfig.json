{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "rootDir": ".",
    "strict": true,
    "checkJs": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node", "@gcoredev/fastedge-sdk-js"]
  },
  "include": [
    "src/**/*",
    "assets/**/*",
    "./node_modules/@gcoredev/fastedge-sdk-js/types"
  ],
  "exclude": ["node_modules"]
}
