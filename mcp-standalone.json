{
    "servers": {
        "fastedge-assistant": {
            "type": "stdio",
            "command": "docker",
            "args": [
                "run",
                "--rm",
                "-i",
                "--pull=always",
                "-v",
                "${workspaceFolder}:/workspace",
                "-e",
                "WORKSPACE_ROOT=/workspace",
                "-e",
                "GCORE_API_KEY",
                "ghcr.io/g-core/fastedge-mcp-server:latest"
            ],
            "env": {
                "GCORE_API_KEY": "${env:GCORE_API_KEY}"
            }
        }
    }
}
