FROM rust:1.95-slim

RUN rustup target add wasm32-wasip1 wasm32-wasip2 && \
    rm -rf /usr/local/cargo/registry /usr/local/cargo/git /usr/local/rustup/tmp/* && \
    rm -rf /usr/local/rustup/toolchains/*/share/doc /usr/local/rustup/toolchains/*/share/man && \
    rm -rf /usr/local/rustup/toolchains/*/lib/rustlib/*/test /usr/local/rustup/toolchains/*/lib/rustlib/*/examples

# WASI SDK: provides clang/cc so crates with native (cc-rs) build scripts
# (ring, openssl-sys, zstd-sys, libz-sys, ...) can compile for the wasm32 targets.
# wasi-sdk releases don't publish a checksum manifest (unlike Node below), so the
# expected digest is pinned here — recompute if the version bumps.
RUN apt-get update && \
    apt-get install -y --no-install-recommends curl ca-certificates && \
    mkdir -p /opt/wasi-sdk && \
    curl -fsSL -o /tmp/wasi-sdk.tar.gz \
      https://github.com/WebAssembly/wasi-sdk/releases/download/wasi-sdk-20/wasi-sdk-20.0-linux.tar.gz && \
    echo "7030139d495a19fbeccb9449150c2b1531e15d8fb74419872a719a7580aad0f9  /tmp/wasi-sdk.tar.gz" | sha256sum -c - && \
    tar -xz -C /opt/wasi-sdk --strip-components=1 -f /tmp/wasi-sdk.tar.gz && \
    rm /tmp/wasi-sdk.tar.gz && \
    apt-get autoremove -y && \
    rm -rf /var/lib/apt/lists/*

# Target-specific only — a global CC/CXX would redirect host-targeted native
# builds (pnpm/node-gyp addons, cargo build scripts for the host) through a
# clang configured for WASI, breaking them.
ENV WASI_SYSROOT=/opt/wasi-sdk/share/wasi-sysroot
ENV PATH="/opt/wasi-sdk/bin:$PATH"
ENV CC_wasm32_wasip1=/opt/wasi-sdk/bin/clang
ENV CXX_wasm32_wasip1=/opt/wasi-sdk/bin/clang++
ENV CC_wasm32_wasip2=/opt/wasi-sdk/bin/clang
ENV CXX_wasm32_wasip2=/opt/wasi-sdk/bin/clang++

# Install Node.js v24 using NodeSource binary distribution
# Support multiple architectures
RUN apt-get update && \
    apt-get install -y --no-install-recommends curl ca-certificates xz-utils bash && \
    ARCH=$(dpkg --print-architecture) && \
    case "$ARCH" in \
        amd64) NODE_ARCH="x64" ;; \
        arm64) NODE_ARCH="arm64" ;; \
        *) echo "Unsupported architecture: $ARCH" && exit 1 ;; \
    esac && \
    curl -fsSLO https://nodejs.org/dist/v24.12.0/node-v24.12.0-linux-${NODE_ARCH}.tar.xz && \
    curl -fsSL https://nodejs.org/dist/v24.12.0/SHASUMS256.txt -o SHASUMS256.txt && \
    grep "node-v24.12.0-linux-${NODE_ARCH}.tar.xz" SHASUMS256.txt | sha256sum -c - && \
    tar -xJf node-v24.12.0-linux-${NODE_ARCH}.tar.xz -C /usr/local --strip-components=1 && \
    rm node-v24.12.0-linux-${NODE_ARCH}.tar.xz SHASUMS256.txt && \
    apt-get purge -y xz-utils && \
    apt-get autoremove -y && \
    rm -rf /var/lib/apt/lists/* /usr/share/doc /usr/share/man /usr/share/info /tmp/*

# Install pnpm
RUN npm install -g pnpm@10.26.2

# Ensure bash is the default shell and set up proper shell environment for Windows Docker Desktop
RUN ln -sf /bin/bash /bin/sh && \
    echo 'export PS1="\u@\h:\w\$ "' >> /etc/bash.bashrc && \
    echo 'export PATH=$PATH:/usr/local/bin' >> /etc/bash.bashrc

# Set default shell to bash for better Windows Docker Desktop compatibility
SHELL ["/bin/bash", "-c"]

# Set environment variables for better shell experience
ENV SHELL=/bin/bash
ENV TERM=xterm-256color
